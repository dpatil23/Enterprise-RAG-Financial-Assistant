# LLM Provider Configuration (Puter / Groq / OpenAI / Ollama)
# For Puter.com (Free Claude 3.5 Sonnet, GPT-4o, Grok-2):
# 1. Sign in to https://puter.com/dashboard
# 2. Click "Create Token" and paste below
LLM_PROVIDER="puter"
LLM_BASE_URL="https://api.puter.com/puterai/openai/v1/"
LLM_API_KEY=""
LLM_MODEL="claude-3-5-sonnet"

# Alternative: Groq Configuration (Fast LLaMA 3.3)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Vector Store & Embedding Settings
EMBEDDING_MODEL="all-MiniLM-L6-v2"
CHROMA_PERSIST_DIR="./chroma_db"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="ragproject123"
